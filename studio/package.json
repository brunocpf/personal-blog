{
  "name": "personal-blog",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "login": "sanity login",
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "validate": "sanity documents validate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/block-content-to-markdown": "^1.0.0",
    "@sanity/code-input": "^7.3.9",
    "@sanity/vision": "^6.17.0",
    "easymde": "^2.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.17.0",
    "sanity-plugin-markdown": "^9.0.14",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "prettier": "^3.0.2",
    "typescript": "^5.1.6"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
